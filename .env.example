# Tender environment variables.
# Copy this file to .env.local (git-ignored) and fill in what you use. Nothing here is required to run
# the site locally; payments need TENDER_DEMO_PAYER_PRIVATE_KEY.
# Variables hold secrets, endpoints, and deploy identity only. Product behavior is never switched here.

# --- USDC payments on Base Sepolia (x402) -------------------------------------------------------
# Private key (0x + 64 hex) of the testnet wallet that pays for requests run from the console.
# `bun run payments:wallets` creates one in .env.local if it is missing and prints its address.
# Fund it with Base Sepolia USDC at https://faucet.circle.com. Testnet only; never use a mainnet key.
TENDER_DEMO_PAYER_PRIVATE_KEY=

# Optional. Base Sepolia JSON-RPC endpoint for balance reads. Default: https://sepolia.base.org
TENDER_RPC_URL=

# Optional. x402 facilitator that verifies and settles payments. Default: https://facilitator.payai.network
TENDER_FACILITATOR_URL=

# --- Paid smoke test against a protected Vercel preview ------------------------------------------
# Used only by `bun run payments:smoke <url>` when the deployment is behind Vercel Deployment
# Protection. The bypass secret is sent only to the HTTPS origin in TENDER_PREVIEW_URL.
TENDER_PREVIEW_URL=
VERCEL_AUTOMATION_BYPASS_SECRET=

# --- PayPal ----------------------------------------------------------------------------------------
# REST app credentials. Sandbox apps: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the webhook that receives PAYMENT.CAPTURE.COMPLETED and payout events (signature verification).
PAYPAL_WEBHOOK_ID=
# Optional. PayPal REST endpoint. Default: https://api-m.sandbox.paypal.com (sandbox)
PAYPAL_API_BASE=

# --- AI ------------------------------------------------------------------------------------------
# Vercel AI Gateway key for the Ask Tender agent and the provider bidding agents, for local
# development. On Vercel, the AI Gateway can authenticate with the project's OIDC token instead.
AI_GATEWAY_API_KEY=
